# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- PAYG CRYPTOGRAPHIC & GATEWAY CONFIGURATIONS ---
# Primary cryptographic algorithm (e.g., AES-256-GCM, ECDSA_P256)
PAYG_PRIMARY_ALGORITHM="AES-256-GCM"

# Signature algorithm used for verification (e.g., Ed25519, ECDSA_SHA256)
PAYG_SIGNATURE_ALGORITHM="Ed25519"

# Handshake latency clearing simulation delay (ms)
HANDSHAKE_LATENCY_DELAY_MS=100

# Maximum permitted millisecond window for 101.1 secure handshake resolution
ONLINE_HANDSHAKE_TIMEOUT_MS=10000

# Enforces cryptographic signing directly in high-security enclave hardware (e.g., HSM, AWS_NITRO, INTEL_SGX)
ENCLAVE_SIGNING_CO_PROCESSOR="HSM"

# HSM Specific Provider (e.g., AWS_CLOUDHSM, GEMALTO)
HSM_PROVIDER="AWS_CLOUDHSM"

# HSM Key Label used to identify corresponding key inside HSM slots
HSM_KEY_LABEL="PAYG_SIGNING_KEY"

# Gateway Authentication Key used to settle digital ledgers with centralized processors
GATEWAY_AUTHENTICATION_KEY="gpay_secure_live_key_99348"

# --- PAYG DIGITAL SIGNATURE CONFIGURATIONS ---
PRIMARY_SIGNATURE_ALGORITHM="Ed25519"
SECONDARY_SIGNATURE_ALGORITHM="ECDSA-P256"
LEGACY_SIGNATURE_ALGORITHM="RSA-PSS-3072"

PAYG_SIGNATURE_VERSION="1.0"
PAYG_SIGNATURE_HASH="SHA-512"
PAYG_SIGNATURE_KEY_SIZE=256
PAYG_SIGNATURE_ENCODING="Base64URL"
PAYG_SIGNATURE_VERIFICATION="STRICT"
PAYG_SIGNATURE_ROTATION_DAYS=90
PAYG_SIGNATURE_HSM_REQUIRED=true
PAYG_SIGNATURE_FIPS_MODE="Optional"
PAYG_SIGNATURE_PROVIDER="libsodium"
PAYG_SIGNATURE_FAIL_POLICY="DENY"
PAYG_SIGNATURE_LOGGING="ENABLED"

